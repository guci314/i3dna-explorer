%% i3dna-engine M1 类型层类图
classDiagram
    direction TB

    class 节点 {
        +path str
        +名() str
    }

    class 树根 {
        +域们() 域[]
        +类们() 类[]
        +找类(名) 类
        +_是类根(croot) bool
        +_造类(croot) 类
        +案卷库() 案卷库
    }

    class 域 {
        +域主() str
        +职责() str
        +白名单() list
        +类们() 类[]
    }

    class 类 {
        +根() 树根
        +范畴() str
        +关系们() list
    }

    class 实体类 {
        +schema声明() dict
        +键说明() dict
        +属主表() dict
        +默认表() dict
        +档案袋们() 档案袋[]
    }

    class 过程类 {
        +方法规() str[]
        +方法们() 方法[]
    }

    class 方法 {
        +根() 树根
        +指令() str
        +执行者声明() str
        +色() str
        +输入弧们() 输入弧[]
        +产物弧们() 产物弧[]
        +投影们() 投影[]
    }

    class 弧 {
        +声明行 dict
        +方法 方法
        +路径声明() str
        +描述() str
    }

    class 输入弧 {
        +类型声明() str
        +角色() str
        +类型文件() path
    }

    class 产物弧 {
        +跨架产出() bool
    }

    class 投影 {
        +目标() str
        +键() str
        +规则() str
    }

    节点 <|-- 树根
    节点 <|-- 域
    节点 <|-- 类
    节点 <|-- 方法

    类 <|-- 实体类
    类 <|-- 过程类

    弧 <|-- 输入弧
    弧 <|-- 产物弧
    弧 <|-- 投影

    树根 *-- 域 : 域们()
    树根 *-- 类 : 类们()/_造类
    域 *-- 类 : 类们()
    过程类 *-- 方法 : 方法们()
    方法 *-- 弧 : 弧们()

    类 --> 树根 : 根
    方法 --> 树根 : 根
    输入弧 ..> 方法 : 类型文件查找
