%% i3dna-engine M0 实例层类图（实例的世界）
classDiagram
    direction TB

    class 节点 {
        +path str
        +名() str
    }

    class 树根 {
        +案卷库() 案卷库
    }

    class 案卷库 {
        +根 树根
        +架们() str[]
        +全案卷号() set
        +档案袋(类名,案卷号) 档案袋
        +档案袋们(类名) 档案袋[]
        +案卷(类名,案卷号) 案卷
        +部门们() 部门[]
    }

    class 档案袋 {
        +根 树根
        +实体号() str
        +类名() str
        +主文件() path
        +键值区() dict
    }

    class 案卷 {
        +根 树根
        +案卷号() str
        +类名() str
        +文件们() str[]
        +账() 账
        +同键档案袋() 档案袋
    }

    class 账 {
        +根 树根
        +记录们() dict
        +最后执行者() str
    }

    class 部门 {
        +名称() str
        +职能们() list
    }

    class 实体类 {
        +档案袋们() 档案袋[]
    }

    class 投影 {
        +目标() str
        +键() str
        +规则() str
    }

    节点 <|-- 案卷库
    节点 <|-- 档案袋
    节点 <|-- 案卷
    节点 <|-- 账
    档案袋 <|-- 部门

    案卷库 *-- 档案袋 : 档案袋(们)()
    案卷库 *-- 案卷 : 案卷()
    案卷库 *-- 部门 : 部门们()
    案卷 *-- 账 : __账

    案卷 ..> 档案袋 : 同键档案袋(同键双柜)

    树根 ..> 案卷库 : 案卷库 属性
    实体类 ..> 案卷库 : 档案袋们(按类名)
    投影 ..> 档案袋 : 事件写实体→键值区
